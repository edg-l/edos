#!/usr/bin/env python3
"""Report what a pull request does to the size of the boot image.

`scripts/image-sizes` measures the built tree; this compares those numbers
against the last successful run on trunk and leaves one comment on the pull
request, rewritten in place on every push rather than added to. A diff shows
what changed in the source and says nothing about what it costs the image that
has to fit in RAM for the whole boot, which is the number worth seeing.

    scripts/pr-size-comment <pr-number> [sizes.txt]

Needs `gh` authenticated with write access to the repository, so it is skipped
for pull requests from forks, where the token is read only. A trunk run with no
recorded sizes yet is not an error: the table is printed without a comparison.
"""

import json
import os
import subprocess
import sys
import tempfile

MARKER = "<!-- edos-image-sizes -->"
ARTIFACT = "image-sizes"
REPO = os.environ.get("GITHUB_REPOSITORY", "edg-l/edos")


def gh(*args, check=True):
    return subprocess.run(
        ["gh", *args], capture_output=True, text=True, check=check
    ).stdout.strip()


def read_sizes(path):
    out = {}
    with open(path) as f:
        for line in f:
            if line.strip():
                name, value = line.rstrip("\n").split("\t")
                out[name] = int(value)
    return out


def baseline():
    """The sizes recorded by the most recent successful trunk run, if any."""
    runs = gh(
        "run", "list", "--repo", REPO, "--workflow", "ci.yml",
        "--branch", "trunk", "--status", "success", "--limit", "10",
        "--json", "databaseId",
    )
    for run in json.loads(runs or "[]"):
        with tempfile.TemporaryDirectory() as tmp:
            try:
                gh("run", "download", str(run["databaseId"]), "--repo", REPO,
                   "--name", ARTIFACT, "--dir", tmp)
            except subprocess.CalledProcessError:
                continue
            return read_sizes(os.path.join(tmp, "sizes.txt"))
    return None


def human(n):
    if n < 1024:
        return f"{n} B"
    for unit, scale in (("KiB", 1024), ("MiB", 1024 ** 2), ("GiB", 1024 ** 3)):
        if n < scale * 1024:
            return f"{n / scale:.2f} {unit}"
    return f"{n} B"


def delta(base, head):
    if base is None:
        return "new"
    if base == head:
        return "="
    sign = "+" if head > base else ""
    pct = (head - base) / base * 100 if base else 0
    return f"{sign}{human(head - base)} ({sign}{pct:.2f}%)"


# `programs` is a count, not a size, so it does not get the byte formatting.
def render(head, base):
    rows = ["| | base | this PR | |", "|---|--:|--:|--:|"]
    for name, value in head.items():
        was = base.get(name) if base else None
        if name == "programs":
            shown, before = str(value), (str(was) if was is not None else "")
            change = "=" if was == value else (f"{value - was:+d}" if was else "new")
        else:
            shown = human(value)
            before = human(was) if was is not None else ""
            change = delta(was, value)
        rows.append(f"| {name} | {before} | {shown} | {change} |")
    note = "" if base else "\nNo trunk run has recorded sizes yet, so there is nothing to compare against."
    return f"{MARKER}\n### Boot image\n\n" + "\n".join(rows) + "\n" + note


def upsert(pr, body):
    comments = json.loads(gh(
        "api", f"repos/{REPO}/issues/{pr}/comments", "--paginate",
        "--jq", "[.[] | {id, body}]",
    ) or "[]")
    for c in comments:
        if MARKER in (c.get("body") or ""):
            gh("api", "--method", "PATCH",
               f"repos/{REPO}/issues/comments/{c['id']}",
               "-f", f"body={body}")
            return
    gh("api", "--method", "POST", f"repos/{REPO}/issues/{pr}/comments",
       "-f", f"body={body}")


def main():
    if len(sys.argv) < 2:
        sys.exit("usage: pr-size-comment <pr-number> [sizes.txt]")
    pr = sys.argv[1]
    sizes = sys.argv[2] if len(sys.argv) > 2 else "sizes.txt"
    body = render(read_sizes(sizes), baseline())
    print(body)
    upsert(pr, body)


if __name__ == "__main__":
    main()
