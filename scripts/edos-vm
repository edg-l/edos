#!/usr/bin/env python3
"""Drive a headless EDOS VM over QEMU's QMP socket.

Boots the ISO with no local display, exposing a VNC server for humans and a QMP
socket for scripts. Screenshots come back as PNG, keystrokes and pointer events
go in as synthetic input, so the guest cannot tell them from a real keyboard.

    scripts/edos-vm start
    scripts/edos-vm shot /tmp/desktop.png
    scripts/edos-vm type 'ls /bin'
    scripts/edos-vm key ret
    scripts/edos-vm windows
    scripts/edos-vm focus Terminal
    scripts/edos-vm panel
    scripts/edos-vm press clock
    scripts/edos-vm log -n 40
    scripts/edos-vm stop
"""

import argparse
import json
import os
import shutil
import socket
import subprocess
import sys
import time

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
RUNDIR = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "edos-vm")
SOCK = os.path.join(RUNDIR, "qmp.sock")
PIDFILE = os.path.join(RUNDIR, "qemu.pid")
GEOMETRY = os.path.join(RUNDIR, "geometry")
SERIAL_LOG = os.path.join(REPO, "run_log.txt")

# The guest decodes scancodes with a hard-coded Spanish 105-key ISO layout
# (programs/edos_lib/src/keymap.rs), so a character maps to whichever physical
# key carries it on that layout, not on US. Verified against a running guest.
PLAIN = {
    "-": "slash", "'": "minus", ".": "dot", ",": "comma",
    "<": "less", "`": "bracket_left", "+": "bracket_right",
    " ": "spc", "\t": "tab", "\n": "ret",
}
SHIFT = {
    "/": "7", "?": "minus", ":": "dot", ";": "comma", ">": "less",
    "_": "slash",
    "^": "bracket_left", "*": "bracket_right",
    "!": "1", '"': "2", "$": "4", "%": "5", "&": "6",
    "(": "8", ")": "9", "=": "0",
}
ALTGR = {
    "|": "1", "@": "2", "#": "3", "~": "4", "\\": "grave_accent",
    "[": "bracket_left", "]": "bracket_right", "{": "apostrophe",
    "}": "backslash",
}

def keystroke(ch):
    """Return the QMP key list that produces `ch`, or None if unmapped."""
    if ch.isdigit():
        return [ch]
    if "a" <= ch <= "z":
        return [ch]
    if "A" <= ch <= "Z":
        return ["shift", ch.lower()]
    for table, mod in ((PLAIN, None), (SHIFT, "shift"), (ALTGR, "alt_r")):
        if ch in table:
            return ([mod] if mod else []) + [table[ch]]
    return None


class Qmp:
    def __init__(self, path=SOCK):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(10)
        self.sock.connect(path)
        self.io = self.sock.makefile("rw")
        json.loads(self.io.readline())
        self.cmd("qmp_capabilities")

    def cmd(self, name, **args):
        req = {"execute": name}
        if args:
            req["arguments"] = args
        self.io.write(json.dumps(req) + "\n")
        self.io.flush()
        while True:
            reply = json.loads(self.io.readline())
            if "event" in reply:
                continue
            if "error" in reply:
                raise SystemExit(f"qmp {name}: {reply['error']['desc']}")
            return reply.get("return")

    def send_key(self, keys, hold_ms=None):
        args = {"keys": [{"type": "qcode", "data": k} for k in keys]}
        if hold_ms:
            args["hold-time"] = hold_ms
        self.cmd("send-key", **args)


def screen_size():
    """The running guest's screen, measured rather than assumed.

    A pointer command that disagrees with the guest's real size computes the
    wrong absolute coordinate and nothing catches it, so this asks: one
    screendump, whose PNG header carries the framebuffer's dimensions. The
    answer is cached, because the mode is set at boot (`limine.conf`) and does
    not change under a running guest.
    """
    try:
        with open(GEOMETRY) as f:
            width, height = f.read().strip().split("x")
        return int(width), int(height)
    except (OSError, ValueError):
        pass

    probe = os.path.join(RUNDIR, "geometry.png")
    if os.path.exists(probe):
        os.unlink(probe)
    Qmp().cmd("screendump", filename=probe, format="png")
    # screendump returns before the file is written: QEMU completes it on the
    # next display update, so a read straight after gets nothing or a partial
    # header.
    header = b""
    for _ in range(40):
        try:
            with open(probe, "rb") as f:
                header = f.read(24)
        except OSError:
            header = b""
        if len(header) == 24:
            break
        time.sleep(0.05)
    os.unlink(probe)
    if header[:8] != b"\x89PNG\r\n\x1a\n":
        raise SystemExit("screendump did not produce a PNG")
    width = int.from_bytes(header[16:20], "big")
    height = int.from_bytes(header[20:24], "big")
    with open(GEOMETRY, "w") as f:
        f.write(f"{width}x{height}")
    return width, height


def running():
    if not os.path.exists(PIDFILE):
        return None
    with open(PIDFILE) as f:
        pid = int(f.read().strip())
    try:
        os.kill(pid, 0)
    except OSError:
        return None
    return pid


def _disk_format(path):
    """qcow2 for the development image, raw for scratch disks; guessing wrong
    makes QEMU refuse the drive."""
    with open(path, "rb") as f:
        return "qcow2" if f.read(4) == b"QFI\xfb" else "raw"


def cmd_start(args):
    if running():
        raise SystemExit("already running; stop it first")

    iso = os.path.join(REPO, "edos-x86_64.iso")
    disk = args.disk if os.path.isabs(args.disk) else os.path.join(REPO, args.disk)
    required = [(disk, f"create {args.disk}")]
    if not args.no_cdrom:
        required.append((iso, "make all"))
    usb_disk = None
    if args.usb_disk:
        usb_disk = (args.usb_disk if os.path.isabs(args.usb_disk)
                    else os.path.join(REPO, args.usb_disk))
        required.append((usb_disk, f"make {os.path.basename(usb_disk)}"))
    for path, target in required:
        if not os.path.exists(path):
            raise SystemExit(f"missing {os.path.basename(path)}; run `{target}` first")

    disk_format = _disk_format(disk)

    os.makedirs(RUNDIR, exist_ok=True)
    for stale in (SOCK, PIDFILE):
        if os.path.exists(stale):
            os.unlink(stale)

    mem = args.mem
    qemu = [
        "qemu-system-x86_64",
        "-M", "q35",
        "-cpu", "qemu64,+sse4.1,+sse4.2,+x2apic,+fsgsbase,+invtsc",
        "-accel", args.accel,
        "-object", f"memory-backend-memfd,id=mem1,size={mem}",
        "-machine", "memory-backend=mem1",
        "-m", mem,
        "-smp", str(args.smp),
        "-drive", f"if=pflash,unit=0,format=raw,file={REPO}/ovmf/ovmf-code-x86_64.fd,readonly=on",
        "-drive", f"if=pflash,unit=1,format=raw,file={REPO}/ovmf/ovmf-vars-x86_64.fd",
        "-drive", f"id=sata0,if=none,format={disk_format},file={disk},aio=io_uring,discard=unmap",
        "-device", "ide-hd,drive=sata0,bus=ide.1",
        # blob=on needs udmabuf and a local display; plain virtio-vga renders
        # into a buffer QEMU itself owns, which is what VNC and screendump read.
        "-vga", "none",
        # The mode comes from limine.conf, which the guest boots with; these
        # only bound what the device will offer.
        "-device", "virtio-vga,xres=1920,yres=1080",
        # usb-tablet reports absolute positions, which the guest reads out of
        # the device's own HID report descriptor. usb-mouse is kept for testing
        # the relative path, and is what a guest older than that parser needs.
        "-device", "qemu-xhci", "-device", "usb-kbd",
        "-device", f"usb-{args.pointer}",
        "-netdev", f"user,id=net0,hostfwd=tcp:127.0.0.1:{args.ssh_fwd}-:23",
        "-device", "e1000e,netdev=net0",
        # audiodev=none, not pipewire: the guest HDA driver runs its DMA engine
        # and interrupts either way, and pipewire refuses to start without a
        # session bus, which is exactly the case this script exists for.
        "-audiodev", "none,id=snd0",
        "-device", "intel-hda", "-device", "hda-output,audiodev=snd0",
        "-serial", f"file:{SERIAL_LOG}",
        "-no-reboot",
        "-display", "none",
        "-qmp", f"unix:{SOCK},server,nowait",
        "-pidfile", PIDFILE,
        "-daemonize",
    ]

    # SPICE streams damage as the guest produces it and lets the client draw
    # the cursor; QEMU's VNC server instead polls the display on a ~30ms timer,
    # which caps a viewer near 33fps however fast the guest paints. VNC stays
    # the default because it needs no client beyond a VNC viewer.
    if args.display == "spice":
        # streaming-video=off: SPICE otherwise watches for a fast-changing
        # rectangle and re-encodes it as lossy video. A dragged window is
        # exactly what trips that, and lossy video of sharp text and window
        # edges reads as tearing. Bandwidth is not the scarce thing on a LAN.
        qemu += ["-spice",
                 f"port={args.spice_port},addr={args.vnc_addr},disable-ticketing=on,"
                 f"streaming-video={args.spice_streaming}"]
    else:
        qemu += ["-vnc", f"{args.vnc_addr}:{args.vnc}"]

    if not args.no_cdrom:
        qemu += ["-cdrom", iso]

    # `make run-capture` needs a local display; this is the same filter-dump
    # for a headless boot, and writes the same pcap.
    if args.pcap:
        pcap = args.pcap if os.path.isabs(args.pcap) else os.path.join(REPO, args.pcap)
        qemu += ["-object", f"filter-dump,id=dump0,netdev=net0,file={pcap}"]

    # Hangs off the same qemu-xhci as the keyboard and mouse, so the guest
    # reaches it through its own xHCI driver rather than a second controller.
    if usb_disk:
        qemu += [
            "-drive", f"id=usbdisk0,if=none,format={_disk_format(usb_disk)},file={usb_disk}",
            "-device", "usb-storage,drive=usbdisk0",
        ]

    # /dev/kvm is group-owned; re-exec under the group if the caller's session
    # predates their membership. Absolute path because `sg` is also the name of
    # the ast-grep binary, which shadows it on some PATHs.
    if args.accel == "kvm" and not os.access("/dev/kvm", os.W_OK):
        if os.path.exists("/usr/bin/sg"):
            qemu = ["/usr/bin/sg", "kvm", "-c", " ".join(map(_quote, qemu))]
        else:
            raise SystemExit("/dev/kvm not writable; add yourself to the kvm group")

    subprocess.run(qemu, check=True, cwd=REPO)
    for _ in range(50):
        if os.path.exists(SOCK):
            break
        time.sleep(0.1)
    if args.display == "spice":
        print(f"spice    spice://{args.vnc_addr}:{args.spice_port}")
    else:
        print(f"vnc      {args.vnc_addr}:{5900 + args.vnc} (display :{args.vnc})")
    print(f"qmp      {SOCK}")
    print(f"serial   {SERIAL_LOG}")


def _quote(s):
    return "'" + s.replace("'", "'\\''") + "'" if any(c in s for c in " \t'\"") else s


def cmd_stop(args):
    pid = running()
    if not pid:
        print("not running")
        return
    try:
        Qmp().cmd("quit")
    except OSError:
        os.kill(pid, 15)
    for _ in range(50):
        if not running():
            break
        time.sleep(0.1)
    for stale in (SOCK, PIDFILE):
        if os.path.exists(stale):
            os.unlink(stale)
    print("stopped")


def cmd_status(args):
    pid = running()
    if not pid:
        print("not running")
        return
    q = Qmp()
    status = q.cmd("query-status")
    spice = q.cmd("query-spice") or {}
    if spice.get("enabled"):
        display = f"spice {spice.get('host')}:{spice.get('port')}"
    else:
        vnc = q.cmd("query-vnc")
        display = f"vnc {vnc.get('host')}:{vnc.get('service')}"
    print(f"pid {pid}, {status['status']}, {display}")


def cmd_shot(args):
    out = os.path.abspath(args.file)
    Qmp().cmd("screendump", filename=out, format="png")
    print(out)


def cmd_type(args):
    q = Qmp()
    text = " ".join(args.text)
    for ch in text:
        keys = keystroke(ch)
        if keys is None:
            raise SystemExit(f"no key for {ch!r} on the guest's Spanish ISO layout")
        q.send_key(keys)
        time.sleep(args.delay)
    if args.enter:
        q.send_key(["ret"])


def cmd_key(args):
    q = Qmp()
    for combo in args.keys:
        q.send_key(combo.split("+"))
        time.sleep(args.delay)


def cmd_move(args):
    goto(Qmp(), args.x, args.y, args.width, args.height)


def cmd_click(args):
    q = Qmp()
    goto(q, args.x, args.y, args.width, args.height)
    for down in (True, False):
        q.cmd("input-send-event", events=[
            {"type": "btn", "data": {"button": args.button, "down": down}},
        ])
        time.sleep(0.05)


# A boot-mouse report carries one signed byte per axis, so every motion is
# delivered in steps this size or smaller.
STEP = 120

# QEMU's absolute axes run over this range whatever the guest resolution is.
ABS_MAX = 32767


def goto(q, x, y, width, height):
    """Place the pointer on an exact pixel.

    With a tablet this is one event and it lands exactly; QEMU scales the axis
    range and the guest scales it back through the logical maximum its report
    descriptor declares. With a relative mouse there is no way to name a pixel,
    so the pointer is slammed past the top-left corner -- the guest clamps to
    the screen and applies no acceleration -- and counted from there.
    """
    if pointer_is_absolute(q):
        q.cmd("input-send-event", events=[
            {"type": "abs", "data": {"axis": "x", "value": x * ABS_MAX // max(width - 1, 1)}},
            {"type": "abs", "data": {"axis": "y", "value": y * ABS_MAX // max(height - 1, 1)}},
        ])
        time.sleep(0.02)
        return
    _drag(q, -width - STEP, -height - STEP)
    _drag(q, x, y)


def pointer_is_absolute(q):
    """Whether the running guest has an absolute pointing device.

    Asked of QEMU rather than assumed from this script's own default, since the
    VM may have been started with --pointer mouse or by an older version. It
    takes the caller's connection: QMP serves one client at a time, so opening
    a second one here would block until the first went away.
    """
    try:
        return any(m.get("current") and m.get("absolute") for m in q.cmd("query-mice"))
    except (SystemExit, OSError, TypeError):
        return False


def _drag(q, dx, dy):
    while dx or dy:
        sx = max(-STEP, min(STEP, dx))
        sy = max(-STEP, min(STEP, dy))
        events = []
        if sx:
            events.append({"type": "rel", "data": {"axis": "x", "value": sx}})
        if sy:
            events.append({"type": "rel", "data": {"axis": "y", "value": sy}})
        q.cmd("input-send-event", events=events)
        dx -= sx
        dy -= sy
        # One HID report per poll of the interrupt endpoint; firing them faster
        # than the guest drains the ring silently loses motion.
        time.sleep(0.012)


def _click_at(x, y, args):
    q = Qmp()
    goto(q, x, y, args.width, args.height)
    for down in (True, False):
        q.cmd("input-send-event", events=[
            {"type": "btn", "data": {"button": "left", "down": down}},
        ])
        time.sleep(0.05)


# A headless guest can only talk through the serial console, so anything on
# screen that a script needs to address by name writes where it is into the
# kernel log, tagged so its block can be picked out of an interleaved log. The
# window manager copies /proc/windows on Ctrl+Alt+W (columns from procfs, in
# kernel/src/fs/procfs/mod.rs); the panel and its applications menu publish
# their own controls, which are not windows and appear nowhere else.
WINDOW_DUMP_KEY = "ctrl+alt+w"
WINDOW_DUMP_TAG = "windows|"
PANEL_DUMP_TAG = "panel|"
MENU_DUMP_TAG = "menu|"


def tagged_lines(tag, since=0):
    """Every line the guest published under `tag`, from `since` bytes in."""
    if not os.path.exists(SERIAL_LOG):
        raise SystemExit("no serial log yet")
    with open(SERIAL_LOG, errors="replace") as f:
        f.seek(since)
        return [line.split(tag, 1)[1].strip() for line in f if tag in line]


def last_block(lines, columns, min_fields):
    """The last block of `lines`, each split into at most `columns` fields.

    Every block opens with a header, the one line whose first field is not a
    number, so a dump left over from an earlier state cannot answer for the
    current one.
    """
    block = []
    for line in lines:
        fields = line.split(None, columns - 1)
        if len(fields) < min_fields or not fields[0].isdigit():
            block = []
            continue
        block.append(fields)
    return block


class Region:
    """A rectangle on screen that a click can reach, and what to call it."""

    __slots__ = ("x", "y", "w", "h", "kind", "label")

    def __init__(self, x, y, w, h, kind, label):
        self.x, self.y, self.w, self.h = x, y, w, h
        self.kind, self.label = kind, label

    def centre(self):
        return self.x + self.w // 2, self.y + self.h // 2

    def name(self):
        return self.label or self.kind

    def __str__(self):
        return (f"{self.x:<6} {self.y:<6} {self.w:<5} {self.h:<5} "
                f"{self.kind:<9} {self.label}")


def find_region(name, regions, what):
    """Resolve a region by name: exact, then prefix, then substring.

    Spaces are ignored on both sides, so the row drawn as "Shut down" answers
    to `shutdown` as well.
    """
    def squash(text):
        return text.lower().replace(" ", "")

    key = squash(name)
    for match in (lambda t: t == key,
                  lambda t: t.startswith(key),
                  lambda t: key in t):
        hits = [r for r in regions if match(squash(r.name()))]
        if len(hits) == 1:
            return hits[0]
        if len(hits) > 1:
            raise SystemExit(f"{name!r} matches several {what}: "
                             + ", ".join(repr(r.name()) for r in hits))
    raise SystemExit(f"no {what} matching {name!r}; there are: "
                     + ", ".join(repr(r.name()) for r in regions))


def panel_actions():
    """Where the panel's controls sit, as the panel itself published them.

    Nothing has to be asked for: the panel republishes whenever its layout
    moves, so the last block in the log is the current one.
    """
    rows = last_block(tagged_lines(PANEL_DUMP_TAG), 6, 5)
    regions = [Region(*(int(v) for v in fields[:4]), fields[4],
                      fields[5] if len(fields) > 5 else "")
               for fields in rows]
    if not regions:
        raise SystemExit("the panel published no layout; is edos-taskbar running?")
    return regions


def menu_rows(since):
    """The applications menu's rows, which it publishes as it opens.

    `since` is a byte offset into the serial log taken before the menu was
    asked to open, so a block from an earlier opening cannot answer.
    """
    for _ in range(30):
        time.sleep(0.1)
        rows = last_block(tagged_lines(MENU_DUMP_TAG, since), 5, 5)
        if rows:
            return [Region(*(int(v) for v in fields[:4]), "row", fields[4])
                    for fields in rows]
    raise SystemExit("the applications menu published no rows; did it open?")


def cmd_panel(args):
    print(f"{'X':<6} {'Y':<6} {'W':<5} {'H':<5} {'KIND':<9} LABEL")
    for region in panel_actions():
        print(region)


def cmd_press(args):
    """Click a panel control found by name."""
    region = find_region(args.name, panel_actions(), "panel controls")
    _click_at(*region.centre(), args)


def cmd_launch(args):
    """Open the applications menu and choose a row, both addressed by name."""
    launcher = find_region("launcher", panel_actions(), "panel controls")
    marker = os.path.getsize(SERIAL_LOG)
    _click_at(*launcher.centre(), args)
    row = find_region(args.item, menu_rows(marker), "menu rows")
    _click_at(*row.centre(), args)


class Window:
    __slots__ = ("id", "pid", "x", "y", "w", "h", "z", "flags", "frame", "state", "title")

    def __init__(self, fields, title):
        (self.id, self.pid, self.x, self.y, self.w, self.h, self.z, self.flags) = (
            int(f) for f in fields[:8]
        )
        self.frame = tuple(int(v) for v in fields[8].split(","))
        self.state = fields[9]
        self.title = title

    def client_rect(self):
        """The client area in screen coordinates.

        The origin the kernel reports is the outer one, so the manager's frame
        has to be added back: the reported origin plus half the size lands in
        the title bar of a tall enough window and on the desktop of a short one.
        """
        x = self.x + self.frame[0]
        y = self.y + self.frame[1]
        return x, y, x + self.w, y + self.h

    def outer_rect(self):
        left, top, right, bottom = self.frame
        return (self.x, self.y,
                self.x + self.w + left + right,
                self.y + self.h + top + bottom)

    def on_screen(self):
        return self.state in ("normal", "focused")

    def __str__(self):
        return (f"{self.id:<5} {self.pid:<5} {self.x:<6} {self.y:<6} {self.w:<5} "
                f"{self.h:<5} {self.state:<9} {self.title}")


def window_list():
    """Ask the guest for its window registry and parse the reply.

    Unlike the panel, the registry changes constantly and is dumped only on
    request, so this sends the keystroke and waits for the answer to land.
    """
    if not os.path.exists(SERIAL_LOG):
        raise SystemExit("no serial log yet")

    marker = os.path.getsize(SERIAL_LOG)
    Qmp().send_key(WINDOW_DUMP_KEY.split("+"))
    for _ in range(50):
        time.sleep(0.1)
        if os.path.getsize(SERIAL_LOG) > marker:
            break
    # The dump is several writes, so give the rest of it time to land.
    time.sleep(0.2)

    rows = last_block(tagged_lines(WINDOW_DUMP_TAG), 11, 10)
    return [Window(fields, fields[10] if len(fields) > 10 else "")
            for fields in rows]


def find_window(name, windows):
    """Resolve a window by title, case-insensitively, prefix before substring."""
    name = name.lower()
    for match in (lambda t: t == name,
                  lambda t: t.startswith(name),
                  lambda t: name in t):
        hits = [w for w in windows if match(w.title.lower())]
        if len(hits) == 1:
            return hits[0]
        if len(hits) > 1:
            # Topmost wins: that is the one a person would say they meant.
            return max(hits, key=lambda w: w.z)
    raise SystemExit(f"no window matching {name!r}; open windows: "
                     + ", ".join(repr(w.title) for w in windows))


def cmd_windows(args):
    windows = window_list()
    if not windows:
        raise SystemExit("no windows reported; is the window manager running?")
    print(f"{'ID':<5} {'PID':<5} {'X':<6} {'Y':<6} {'W':<5} {'H':<5} {'STATE':<9} TITLE")
    for window in windows:
        print(window)


def visible_point(window, windows):
    """A point of `window`'s client area that nothing on top of it covers.

    The window manager focuses whatever is under the pointer, so clicking the
    centre of a window that something else overlaps focuses the *other* window
    and silently does the opposite of what was asked. Everything above this one
    in z-order is subtracted from its client area and the surviving point
    nearest the centre wins.
    """
    left, top, right, bottom = window.client_rect()
    above = [w.outer_rect() for w in windows
             if w.z > window.z and w.id != window.id and w.on_screen()]

    def covered(px, py):
        return any(l <= px < r and t <= py < b for l, t, r, b in above)

    cx, cy = (left + right) // 2, (top + bottom) // 2
    # A grid rather than a rectangle subtraction: a dozen candidate points are
    # enough to find a corner of a partly covered window, and the exact largest
    # uncovered region is not worth the geometry.
    steps = 9
    candidates = [
        (left + (right - left) * i // (steps + 1), top + (bottom - top) * j // (steps + 1))
        for i in range(1, steps + 1)
        for j in range(1, steps + 1)
    ]
    free = [(px, py) for px, py in candidates if not covered(px, py)]
    if not free:
        return cx, cy, False
    return (*min(free, key=lambda p: abs(p[0] - cx) + abs(p[1] - cy)), True)


def cmd_focus(args):
    """Click into a window found by name, which is what focuses it."""
    windows = window_list()
    window = find_window(args.name, windows)
    if args.dx is not None:
        left, top, _, _ = window.client_rect()
        x, y, clear = left + args.dx, top + args.dy, True
    else:
        x, y, clear = visible_point(window, windows)
    if not clear:
        print(f"warning: {window.title!r} is fully covered; the click will land "
              "on whatever is on top of it", file=sys.stderr)
    _click_at(x, y, args)
    print(f"clicked {window.title!r} at {x},{y}")


def cmd_log(args):
    if not os.path.exists(SERIAL_LOG):
        raise SystemExit("no serial log yet")
    with open(SERIAL_LOG, errors="replace") as f:
        lines = f.readlines()
    sys.stdout.write("".join(lines[-args.n:]))


def cmd_qmp(args):
    payload = json.loads(args.args) if args.args else {}
    print(json.dumps(Qmp().cmd(args.command, **payload), indent=2))


def main():
    p = argparse.ArgumentParser(description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("start", help="boot the VM headless")
    s.add_argument("--vnc", type=int, default=1, help="VNC display number (port 5900+N)")
    s.add_argument("--vnc-addr", default="127.0.0.1", help="VNC bind address")
    s.add_argument("--display", default="vnc", choices=["vnc", "spice"],
                   help="remote display protocol; spice streams damage, vnc polls")
    s.add_argument("--spice-port", type=int, default=5930)
    s.add_argument("--spice-streaming", default="off", choices=["off", "filter", "all"],
                   help="SPICE lossy video detection; off keeps text sharp")
    s.add_argument("--pointer", default="tablet", choices=["tablet", "mouse"],
                   help="absolute (tablet) or relative (mouse) pointing device")
    s.add_argument("--smp", type=int, default=4)
    s.add_argument("--mem", default="2G")
    s.add_argument("--accel", default="kvm", choices=["kvm", "tcg"])
    s.add_argument("--disk", default="sata-disk.img",
                   help="disk image attached as the SATA drive")
    s.add_argument("--usb-disk", nargs="?", const="usb-test.img", default=None,
                   metavar="IMAGE",
                   help="attach IMAGE (default usb-test.img) as a USB mass-storage device")
    s.add_argument("--no-cdrom", action="store_true",
                   help="boot without the ISO, e.g. to test an installed disk")
    s.add_argument("--ssh-fwd", type=int, default=2323,
                   help="host port forwarded to guest TCP 23")
    s.add_argument("--pcap", metavar="FILE",
                   help="dump every frame on the NIC to FILE (pcap)")
    s.set_defaults(func=cmd_start)

    sub.add_parser("stop", help="shut the VM down").set_defaults(func=cmd_stop)
    sub.add_parser("status", help="show VM state").set_defaults(func=cmd_status)

    s = sub.add_parser("shot", help="write a PNG screenshot")
    s.add_argument("file", nargs="?", default="edos-shot.png")
    s.set_defaults(func=cmd_shot)

    s = sub.add_parser("type", help="type text into the guest")
    s.add_argument("text", nargs="+")
    s.add_argument("--delay", type=float, default=0.03)
    s.add_argument("--enter", action="store_true", help="append Return")
    s.set_defaults(func=cmd_type)

    s = sub.add_parser("key", help="send raw qcodes, e.g. ret ctrl+c alt+f4")
    s.add_argument("keys", nargs="+")
    s.add_argument("--delay", type=float, default=0.05)
    s.set_defaults(func=cmd_key)

    for name, fn, extra in (("move", cmd_move, False), ("click", cmd_click, True)):
        s = sub.add_parser(name, help=f"{name} the pointer at a pixel")
        s.add_argument("x", type=int)
        s.add_argument("y", type=int)
        s.add_argument("--width", type=int)
        s.add_argument("--height", type=int)
        if extra:
            s.add_argument("--button", default="left",
                           choices=["left", "middle", "right"])
        s.set_defaults(func=fn)

    s = sub.add_parser("launch", help="open the applications menu and choose a row")
    s.add_argument("item", nargs="?", default="terminal",
                   help="a menu row's label; spaces and case are ignored")
    s.add_argument("--width", type=int)
    s.add_argument("--height", type=int)
    s.set_defaults(func=cmd_launch)

    sub.add_parser("panel", help="list the panel's controls by name").set_defaults(
        func=cmd_panel)

    s = sub.add_parser("press", help="click a panel control found by name")
    s.add_argument("name")
    s.add_argument("--width", type=int)
    s.add_argument("--height", type=int)
    s.set_defaults(func=cmd_press)

    sub.add_parser("windows", help="list the guest's windows by name").set_defaults(
        func=cmd_windows)

    s = sub.add_parser("focus", help="click into a window found by title")
    s.add_argument("name")
    s.add_argument("--dx", type=int, help="click this far into the client area instead"
                                          " of its centre")
    s.add_argument("--dy", type=int, default=0)
    s.add_argument("--width", type=int)
    s.add_argument("--height", type=int)
    s.set_defaults(func=cmd_focus)

    s = sub.add_parser("log", help="tail the guest serial log")
    s.add_argument("-n", type=int, default=20)
    s.set_defaults(func=cmd_log)

    s = sub.add_parser("qmp", help="run an arbitrary QMP command")
    s.add_argument("command")
    s.add_argument("args", nargs="?", help="JSON object of arguments")
    s.set_defaults(func=cmd_qmp)

    args = p.parse_args()
    # Anything that names a pixel needs the guest's real screen, which `start`
    # recorded. An explicit --width/--height still wins.
    if getattr(args, "width", None) is None and hasattr(args, "width"):
        args.width, args.height = screen_size()
    args.func(args)


if __name__ == "__main__":
    main()
