#!/usr/bin/env bash
# Drive the guest and watch WINDOW_REGISTRY for a stuck reader.
#
# Requires a kernel built with --features window-lock-debug. Symbol addresses
# move whenever the kernel is rebuilt, so they are resolved from the binary
# rather than hard-coded:
#
#   make edos-x86_64.iso CARGO_FLAGS="--features window-lock-debug"
#   scripts/edos-vm start
#   scripts/window-lock-soak [rounds]
#
# On detection it dumps the reader table, whose entries decode as
# (tid << 8) | site, naming the thread that never released.
set -u
cd "$(dirname "$0")/.."

ROUNDS=${1:-2000}
KERNEL=kernel/kernel

sym() { nm "$KERNEL" | grep -F "$1" | head -1 | cut -d' ' -f1; }
LOCK=0x$(sym WINDOW_REGISTRY_READERS >/dev/null; nm "$KERNEL" | grep -E "registry15WINDOW_REGISTRY$" | cut -d' ' -f1)
READERS=0x$(nm "$KERNEL" | grep -F "WINDOW_REGISTRY_READERS" | cut -d' ' -f1)
ACQ=0x$(nm "$KERNEL" | grep -F "WINDOW_REGISTRY_READER_ACQUIRES" | cut -d' ' -f1)

if [ "$READERS" = "0x" ]; then
  echo "kernel has no reader table; rebuild with --features window-lock-debug" >&2
  exit 2
fi

SITES=(- cleanup_process_windows handle_mouse_event handle_keyboard_event
       sys_window_get sys_window_poll sys_window_list sys_window_send_event)

peek() {
  scripts/edos-vm qmp human-monitor-command "{\"command-line\":\"x /${2}gx $1\"}" 2>/dev/null \
    | tr -d '"' | grep -oE '0x[0-9a-f]{16}'
}

dump_readers() {
  echo "reader table:"
  local i=0
  for v in $(peek "$READERS" 8); do
    if [ "$v" != "0x0000000000000000" ]; then
      python3 -c "
v = int('$v', 16)
sites = '${SITES[*]}'.split()
site = v & 0xff
name = sites[site] if site < len(sites) else f'site{site}'
print(f'  slot $i: tid={v >> 8} site={name}')"
    fi
    i=$((i + 1))
  done
}

echo "lock=$LOCK readers=$READERS acquires=$ACQ"
stuck=0
for round in $(seq 1 "$ROUNDS"); do
  case $((round % 4)) in
    0) scripts/edos-vm launch >/dev/null 2>&1 ;;
    1) scripts/edos-vm click 400 400 >/dev/null 2>&1
       scripts/edos-vm type 'ps' --enter >/dev/null 2>&1 ;;
    2) scripts/edos-vm raise 0 >/dev/null 2>&1 ;;
    3) scripts/edos-vm click 700 300 >/dev/null 2>&1 ;;
  esac

  v=$(peek "$LOCK" 1)
  if [ -z "$v" ]; then
    echo "round $round: QMP gone, guest died"; exit 2
  fi

  if [ "$v" = "0x0000000000000000" ]; then
    stuck=0
  else
    stuck=$((stuck + 1))
    if [ "$stuck" -ge 3 ]; then
      echo "round $round: lock stuck at $v across $stuck probes"
      dump_readers
      echo "acquires: $(peek "$ACQ" 1)"
      exit 1
    fi
  fi

  if [ $((round % 100)) -eq 0 ]; then
    echo "round $round ok, acquires=$(peek "$ACQ" 1)"
  fi
done
echo "completed $ROUNDS rounds, no stuck reader"
